{
  "name": "talkia",
  "version": "0.1.0",
  "description": "Framework-agnostic client for the Talkia AI browser agent widget.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://talkia.co",
  "keywords": [
    "talkia",
    "ai",
    "agent",
    "chat",
    "widget",
    "assistant"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./client": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "publish": "npm publish --access public"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
